# LLM 配置（OpenAI 兼容协议，eino-ext 统一走这条路径）
# 填其中一个供应商即可。把本文件复制成 .env 后填入真实值（.env 已 gitignore）。

# 1) OpenAI 官方
# ARGENT_LLM_BASE_URL=https://api.openai.com/v1
# ARGENT_LLM_MODEL=gpt-4o-mini

# 2) DeepSeek
# ARGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# ARGENT_LLM_MODEL=deepseek-chat

# 3) 阿里云百炼（DashScope）OpenAI 兼容 —— 注意 base_url 必须带 /v1：
#    eino 底层会在 BaseURL 后拼 /chat/completions，
#    故填 .../compatible-mode/v1 才能得到 .../compatible-mode/v1/chat/completions
# ARGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ARGENT_LLM_MODEL=qwen-plus

# 出口代理（可选，与 Python 版 llm_proxy 一致；本机没跑代理就注释掉，否则连不上 LLM）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 必填：API key（有值才走真模型，空则走本地演示降级）
ARGENT_LLM_API_KEY=

# 选填
ARGENT_LLM_BASE_URL=
ARGENT_LLM_MODEL=gpt-4o-mini
# 备用模型自动切换（逗号分隔）。主模型额度耗尽/下线时按顺序尝试下一个。
# 只从环境变量读，不写进代码。留空则不做切换（与旧行为一致）。
# 例：ARGENT_LLM_FALLBACK_MODELS=qwen3.7-plus,qwen3.7-flash,glm-5.2
ARGENT_LLM_FALLBACK_MODELS=
ARGENT_LLM_PROVIDER=openai
